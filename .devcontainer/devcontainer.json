{
    "name": "irob-saf-ros2",
    "privileged": true,
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "root",
    "runArgs": [
        "--tty",
        "--interactive",
        "--name", "irob-saf-ros2"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "QT_X11_NO_MITSHM": "1"
    },
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=consistent",
        "source=/dev,target=/dev,type=bind"  // TODO: Minor security risk. Container can access all host device files. This should ideally be restricted to the FireWire ports used by the dVRK and whatever USB devices are used
    ],
    // https://github.com/microsoft/vscode-remote-release/issues/3034
    // Dev container refuses to clone the repository anywhere other than /workspace/irob-saf-ros2
    // I symlinked this folder to the actual desired location as a workaround
    // TODO: Update when a better solution is added as per the issue above
    "postCreateCommand": "ln -s /workspaces/irob-saf-ros2 /root/ros2_ws/src || true",
    "customizations": {
        "vscode": {
            "settings": { 
                "extensions.autoUpdate": false
            },
            
            "extensions": [
                "ms-python.python",
                "ms-python.pylint@2024.2.0",  // 2025.* onwards requires Python>=3.9
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "matangover.mypy"
            ]
        }
    }
}
